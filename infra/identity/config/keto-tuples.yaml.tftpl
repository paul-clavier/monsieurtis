# Keto seed tuples — Zanzibar relation rows seeded on every `tofu apply`.
#
# This file is the source of truth for the bootstrap state. The seed Job PUTs
# every tuple here against Keto's write API; PUT is idempotent so re-applies
# converge to the rows listed below.
#
# Removing a tuple from this file does NOT delete it from Keto — runtime
# revocation goes through the Crocus admin UI or a direct DELETE against the
# Keto write API.
#
# Substitutions (rendered by Terraform's `templatefile`):
#   ${"$"}{admin_id} — var.initial_admin_kratos_id. Empty on first apply → the
#               entire seed Job is skipped (see keto.tf), so partial
#               `user:` subjects never reach Keto.
#
# Namespaces must exist in config/keto.yaml.tftpl before they can be used here.

tuples:
    # Crocus admin console access.
    - namespace: crocus-admin
      object: platform
      relation: access
      subject_id: user:${admin_id}

    # Per-app access for the initial admin. Add one entry per registered app
    # (must match the key used in var.registered_apps).
    - namespace: app
      object: linlin
      relation: access
      subject_id: user:${admin_id}
