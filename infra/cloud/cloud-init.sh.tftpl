#!/usr/bin/env bash
set -euo pipefail

# Exit-node forwarding.
cat >/etc/sysctl.d/99-tailscale.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
SYSCTL
sysctl -p /etc/sysctl.d/99-tailscale.conf

curl -fsSL https://tailscale.com/install.sh | sh

# `--advertise-exit-node` + ACL `autoApprovers.exitNode` means this device
# is approved as an exit node the instant it registers, no admin clicks.
tailscale up \
    --authkey=${tailscale_auth_key} \
    --advertise-exit-node \
    --ssh \
    --hostname=monsieurtis-exit \
    --accept-dns=false
