{
    "extends": "@monsieurtis/tsconfig/server.json",
    "compilerOptions": {
        "noEmit": true,
        // Repeated from server.json on purpose: workspace libs (e.g.
        // nest-rest-crud) are transpiled by Bun at runtime using this
        // tsconfig, and Bun ignores decorator options inherited via
        // `extends` (it falls back to TC39 decorators, which breaks NestJS).
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "test", "prisma.config.ts", "vitest.config.ts"]
}
