# syntax=docker/dockerfile:1.10-labs

# The COPY list of workspace sources and BUN_VERSION are generated by
# `tis repo sync` from the workspace graph and package.json `packageManager`.
ARG BUN_VERSION=1.4.5

# ============================================================
# Stage 1: install only linlin-server's transitive deps
# ============================================================
FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY --parents **/package.json ./
RUN bun install --frozen-lockfile --filter linlin-server

# ============================================================
# Stage 2: add source for the workspaces linlin-server uses
# ============================================================
FROM deps AS source
# >>> tis repo sync: workspace sources (generated, do not edit)
COPY lib/eslint-config lib/eslint-config
COPY lib/tsconfig lib/tsconfig
COPY lib/core lib/core
COPY apps/linlin/interfaces apps/linlin/interfaces
COPY lib/packages/nest-rest-crud lib/packages/nest-rest-crud
COPY lib/packages/prisma lib/packages/prisma
COPY apps/linlin/linlin-server apps/linlin/linlin-server
# <<< tis repo sync
RUN cd apps/linlin/linlin-server && bun --bun run prisma generate

# ============================================================
# Stage 3: dev — hot-reload via `nest start --watch`
# ============================================================
FROM source AS dev
WORKDIR /app/apps/linlin/linlin-server
EXPOSE 8000
CMD ["bun", "run", "start:dev"]

# ============================================================
# Stage 4: build the production bundle
# ============================================================
FROM source AS build
RUN cd apps/linlin/linlin-server && bun run build

# ============================================================
# Stage 5: slim production runtime
# ============================================================
FROM oven/bun:${BUN_VERSION}-slim AS prod
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/linlin/linlin-server/node_modules ./apps/linlin/linlin-server/node_modules
COPY --from=build /app/apps/linlin/linlin-server/dist ./apps/linlin/linlin-server/dist
COPY --from=build /app/apps/linlin/linlin-server/package.json ./apps/linlin/linlin-server/
# Bun takes its decorator settings for the workspace lib sources below from
# this tsconfig (see the comment in it): without it Nest decorators break.
COPY --from=build /app/apps/linlin/linlin-server/tsconfig.json ./apps/linlin/linlin-server/
# Workspace libs ship TypeScript sources (resolved through node_modules
# symlinks) that Bun transpiles at runtime, so the runtime needs them too.
# >>> tis repo sync: workspace sources, deps only, from=build:/app (generated, do not edit)
COPY --from=build /app/lib/eslint-config lib/eslint-config
COPY --from=build /app/lib/tsconfig lib/tsconfig
COPY --from=build /app/lib/core lib/core
COPY --from=build /app/apps/linlin/interfaces apps/linlin/interfaces
COPY --from=build /app/lib/packages/nest-rest-crud lib/packages/nest-rest-crud
COPY --from=build /app/lib/packages/prisma lib/packages/prisma
# <<< tis repo sync
COPY --from=build /app/apps/linlin/linlin-server/src/infrastructure/prisma/generated ./apps/linlin/linlin-server/src/infrastructure/prisma/generated
WORKDIR /app/apps/linlin/linlin-server
EXPOSE 8000
CMD ["bun", "run", "start:prod"]
