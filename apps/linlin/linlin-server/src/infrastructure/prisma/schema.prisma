// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id     String            @id @default(uuid()) @db.Uuid
  name   String            @unique
  label  String
  setups SetupIngredient[]
  tags   Tag[]
}

model Setup {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @unique
  label        String
  description  String
  time         Int
  capacity     Int?
  dressing     String?
  subSetups    Setup[]           @relation("SetupSubSetups")
  parentSetups Setup[]           @relation("SetupSubSetups")
  ingredients  SetupIngredient[]
  tags         Tag[]
  photos       SetupPhoto[]
}

model SetupIngredient {
  setupId      String     @db.Uuid
  setup        Setup      @relation(fields: [setupId], references: [id])
  ingredientId String     @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float
  unit         String

  @@id([setupId, ingredientId])
}

model SetupPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  setupId     String   @db.Uuid
  setup       Setup    @relation(fields: [setupId], references: [id], onDelete: Cascade)
  key         String   @unique
  contentType String
  createdAt   DateTime @default(now())

  @@index([setupId])
}

model TagCategory {
  name String @id
  tags Tag[]
}

model Tag {
  name         String       @id
  categoryName String?
  category     TagCategory? @relation(fields: [categoryName], references: [name], onUpdate: Cascade, onDelete: SetNull)
  ingredients  Ingredient[]
  setups       Setup[]

  @@index([categoryName])
}

model SetupView {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  query     String?
  tagNames  String[]
  match     String   @default("any")
  scope     String   @default("all")
  createdAt DateTime @default(now())
}
