// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id     String            @id @default(uuid()) @db.Uuid
  name   String            @unique
  label  String
  setups SetupIngredient[]
  tags   Tag[]
}

model Setup {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @unique
  label        String
  description  String
  time         Int
  capacity     Int?
  subSetups    Setup[]           @relation("SetupSubSetups")
  parentSetups Setup[]           @relation("SetupSubSetups")
  ingredients  SetupIngredient[]
  recipes      Recipe[]
  tags         Tag[]
}

model SetupIngredient {
  setupId      String               @db.Uuid
  setup        Setup                @relation(fields: [setupId], references: [id])
  ingredientId String               @db.Uuid
  ingredient   Ingredient           @relation(fields: [ingredientId], references: [id])
  quantity     Float
  unit         String
  tags         SetupIngredientTag[]

  @@id([setupId, ingredientId])
}

model Recipe {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  label       String
  description String
  capacity    Int?
  time        Int
  setups      Setup[]
}

model TagCategory {
  name String @id
  tags Tag[]
}

model Tag {
  name             String               @id
  categoryName     String?
  category         TagCategory?         @relation(fields: [categoryName], references: [name], onUpdate: Cascade, onDelete: SetNull)
  ingredients      Ingredient[]
  setups           Setup[]
  setupIngredients SetupIngredientTag[]

  @@index([categoryName])
}

// Explicit join table: SetupIngredient has a composite id, so Prisma's implicit m2m can't be used.
model SetupIngredientTag {
  setupId         String          @db.Uuid
  ingredientId    String          @db.Uuid
  setupIngredient SetupIngredient @relation(fields: [setupId, ingredientId], references: [setupId, ingredientId], onDelete: Cascade)
  tagName         String
  tag             Tag             @relation(fields: [tagName], references: [name], onUpdate: Cascade, onDelete: Cascade)

  @@id([setupId, ingredientId, tagName])
  @@index([tagName])
}
