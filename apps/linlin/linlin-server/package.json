{
    "name": "linlin-server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@monsieurtis/core": "workspace:*",
        "@monsieurtis/nest-rest-crud": "workspace:*",
        "@monsieurtis/prisma": "workspace:*",
        "@nestjs/common": "catalog:nest",
        "@nestjs/core": "catalog:nest",
        "@nestjs/platform-express": "catalog:nest",
        "@nestjs/swagger": "catalog:nest",
        "dotenv": "17.4.2",
        "nestjs-zod": "catalog:nest",
        "@prisma/client": "catalog:prisma",
        "@prisma/instrumentation": "catalog:prisma",
        "reflect-metadata": "catalog:nest",
        "rxjs": "catalog:nest",
        "zod": "catalog:zod"
    },
    "devDependencies": {
        "@eslint/eslintrc": "catalog:tooling",
        "@eslint/js": "catalog:tooling",
        "@monsieurtis/tsconfig": "workspace:*",
        "@nestjs/cli": "catalog:nest",
        "@nestjs/schematics": "catalog:nest",
        "@nestjs/testing": "catalog:nest",
        "@swc/cli": "0.7.10",
        "@swc/core": "1.15.33",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "catalog:tooling",
        "@types/supertest": "6.0.3",
        "eslint": "catalog:tooling",
        "eslint-config-prettier": "catalog:tooling",
        "eslint-plugin-prettier": "catalog:tooling",
        "globals": "catalog:tooling",
        "jest": "30.3.0",
        "prettier": "catalog:tooling",
        "prisma": "catalog:prisma",
        "source-map-support": "0.5.21",
        "supertest": "7.2.2",
        "ts-jest": "29.4.9",
        "ts-loader": "9.5.7",
        "ts-node": "catalog:tooling",
        "tsconfig-paths": "catalog:tooling",
        "typescript-eslint": "catalog:tooling"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
