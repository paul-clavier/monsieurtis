{
    "name": "linlin-server",
    "version": "0.0.1",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "prisma:generate": "prisma generate --schema src/infrastructure/prisma/schema.prisma",
        "prisma:validate": "prisma validate --schema src/infrastructure/prisma/schema.prisma",
        "start": "nest start --exec bun",
        "start:dev": "nest start --watch --exec bun",
        "start:debug": "nest start --debug --watch --exec bun",
        "start:prod": "bun dist/main.js",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --passWithNoTests",
        "format": "prettier --write . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore && eslint --fix .",
        "check": "prettier --check . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
    },
    "dependencies": {
        "@monsieurtis/core": "workspace:*",
        "@monsieurtis/linlin-interfaces": "workspace:*",
        "@monsieurtis/nest-rest-crud": "workspace:*",
        "@monsieurtis/prisma": "workspace:*",
        "@nestjs/common": "catalog:nest",
        "@nestjs/core": "catalog:nest",
        "@nestjs/platform-express": "catalog:nest",
        "@nestjs/swagger": "catalog:nest",
        "nestjs-zod": "catalog:nest",
        "@prisma/client": "catalog:prisma",
        "@prisma/instrumentation": "catalog:prisma",
        "reflect-metadata": "catalog:nest",
        "rxjs": "catalog:nest",
        "zod": "catalog:zod"
    },
    "devDependencies": {
        "@monsieurtis/eslint-config": "workspace:*",
        "@monsieurtis/tsconfig": "workspace:*",
        "@nestjs/cli": "catalog:nest",
        "@nestjs/schematics": "catalog:nest",
        "@nestjs/testing": "catalog:nest",
        "@swc/cli": "0.7.10",
        "@swc/core": "1.15.33",
        "@types/express": "5.0.6",
        "@types/node": "catalog:tooling",
        "@types/supertest": "6.0.3",
        "eslint": "catalog:tooling",
        "prettier": "catalog:tooling",
        "prisma": "catalog:prisma",
        "supertest": "7.2.2",
        "vitest": "catalog:build"
    }
}
