# Local Postgres from apps/linlin/linlin-server/compose.yml (`tis linlin up`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linlin?schema=public

# Local S3 (SeaweedFS) from apps/linlin/linlin-server/compose.yml
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linlin-photos
S3_ACCESS_KEY_ID=linlin
S3_SECRET_ACCESS_KEY=linlin-secret
S3_FORCE_PATH_STYLE=true
