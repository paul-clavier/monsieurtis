{
    "extends": "@monsieurtis/tsconfig/client.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": {
            "#/*": ["./src/*"],
            "@/*": ["./src/*"],
            "@/interfaces/*": ["../interfaces/*"],
            "@monsieurtis/core": ["../../../lib/core/src/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", "../interfaces"]
}
