{
    "name": "@monsieurtis/ory-nest",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --passWithNoTests",
        "format": "prettier --write . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore && eslint --fix .",
        "check": "prettier --check . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "dependencies": {
        "@monsieurtis/ory": "workspace:*"
    },
    "peerDependencies": {
        "@nestjs/common": "catalog:nest",
        "@nestjs/core": "catalog:nest"
    },
    "devDependencies": {
        "@monsieurtis/eslint-config": "workspace:*",
        "@monsieurtis/tsconfig": "workspace:*",
        "@nestjs/common": "catalog:nest",
        "@nestjs/core": "catalog:nest",
        "eslint": "catalog:tooling",
        "prettier": "catalog:tooling",
        "reflect-metadata": "catalog:nest",
        "vitest": "catalog:build"
    }
}
