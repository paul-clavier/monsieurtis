{
    "name": "@monsieurtis/cli",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "bin": {
        "tis": "./bin/tis"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --passWithNoTests",
        "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore && eslint --fix .",
        "check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore"
    },
    "devDependencies": {
        "@monsieurtis/eslint-config": "workspace:*",
        "@monsieurtis/tsconfig": "workspace:*",
        "@types/bun": "catalog:tooling",
        "eslint": "catalog:tooling",
        "prettier": "catalog:tooling",
        "vitest": "catalog:build"
    }
}
